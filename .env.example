MATHEWS_ENVIRONMENT=local
MATHEWS_API_HOST=127.0.0.1
MATHEWS_API_PORT=8000
MATHEWS_WEB_ORIGIN=http://localhost:3000

# Local-only PostgreSQL defaults. Use deployment-managed injection outside local development.
MATHEWS_DATABASE_URL=postgresql+psycopg://mathews:mathews@localhost:5432/mathews
MATHEWS_POSTGRES_DB=mathews
MATHEWS_POSTGRES_USER=mathews
MATHEWS_POSTGRES_PASSWORD=mathews
MATHEWS_POSTGRES_PORT=5432
MATHEWS_SKIP_POSTGRES=0
MATHEWS_ARTIFACT_ROOT=.local/artifacts
MATHEWS_HOST_SOCKET_PATH="~/Library/Application Support/Mathews/host-agent.sock"
MATHEWS_HOST_JOURNAL_PATH="~/Library/Application Support/Mathews/host-agent.sqlite3"
MATHEWS_HOST_AUTH_KEY_ID=host-control-plane-v1

# Non-secret integration configuration.
MATHEWS_HERMES_ENDPOINT=http://127.0.0.1:9000
MATHEWS_GITHUB_APP_ID=
MATHEWS_GITHUB_INSTALLATION_ID=
MATHEWS_GITHUB_REPOSITORY_ID=
MATHEWS_TARGET_REPOSITORY_ROOT=

# Opaque references only. Store the corresponding credential values in Keychain.
MATHEWS_HERMES_API_KEY_REF=keychain://com.boppuh.mathews.hermes/api-key
MATHEWS_HOST_AUTH_KEY_REF=keychain://com.boppuh.mathews.host-agent/control-plane-hmac-v1
MATHEWS_GITHUB_PRIVATE_KEY_REF=keychain://com.boppuh.mathews.github-app/private-key
MATHEWS_GITHUB_WEBHOOK_SECRET_REF=keychain://com.boppuh.mathews.github-app/webhook-secret
